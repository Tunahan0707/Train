from typing import Self


class Vector2:
    x: int | float
    y: int | float

    def __init__(self, x: int | float, y: int | float) -> None: ...

    def __add__(self, other: Vector2) -> Vector2: ...
    def __iadd__(self, other: Vector2) -> Self: ...
    def __sub__(self, other: Vector2) -> Vector2: ...
    def __isub__(self, other: Vector2) -> Self: ...

    def __mul__(self, other: int | float) -> Vector2: ...
    def __imul__(self, other: int | float) -> Self: ...
    def __truediv__(self, other: int | float) -> Vector2: ...
    def __rmul__(self, other: int | float) -> Vector2: ...

    def __neg__(self) -> Vector2: ...
    def __eq__(self, value: object) -> bool: ...
    def __ne__(self, value: object) -> bool: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

    def length(self) -> float: ...
    def length_squared(self) -> int | float: ...
    def dot(self, other: Vector2) -> int | float: ...
    def normalize(self) -> Vector2: ...

    def angle_with(self, other: Vector2) -> float: ...
    def angle_to(self, other: Vector2) -> float: ...
    def angle(self) -> float: ...

    def distance_to(self, other: Vector2) -> float: ...
    def rotate(self, angle: int | float) -> Vector2: ...
    def cross(self, other: Vector2) -> int | float: ...

    def projection(self, other: Vector2) -> Vector2: ...
    def reflect(self, normal: Vector2) -> Vector2: ...
    def lerp(self, other: Vector2, t: int | float) -> Vector2: ...

    def perpendicular(self, k: int = 0) -> Vector2: ...

    def is_parallel(self, other: Vector2, eps: float = 1e-12) -> bool: ...
    def is_perpendicular(self, other: Vector2, eps: float = 1e-12) -> bool: ...

    def slope(self) -> float: ...

    def move_towards(
        self,
        target: Vector2,
        max_distance: int | float
    ) -> Vector2: ...

    def clamp_magnitude(self, max_length: int | float) -> Vector2: ...