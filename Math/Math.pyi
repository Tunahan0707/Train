


class DualNumber:
    real: int | float
    dual: int | float

    def __init__(self, real: int | float, dual: int | float) -> None: ...
    def __add__(self, other: int | float | DualNumber) -> DualNumber: ...
    def __sub__(self, other: int | float | DualNumber) -> DualNumber: ...
    def __mul__(self, other: int | float | DualNumber) -> DualNumber: ...
    def __pow__(self, power: int) -> DualNumber: ...
    def __radd__(self, other: int | float) -> DualNumber: ...
    def __rsub__(self, other: int | float) -> DualNumber: ...
    def __rmul__(self, other: int | float) -> DualNumber: ...
    def __truediv__(self, other: int | float | DualNumber) -> DualNumber: ...
    def __rtruediv__(self, other: int | float) -> DualNumber: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __int__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def print_dual(self) -> None: ...
    def print_real(self) -> None: ...


class ComplexNumber:
    real: int | float
    complex: int | float

    def __init__(self, real: int | float, complex: int | float) -> None: ...
    def __add__(self, other: int | float | ComplexNumber) -> ComplexNumber: ...
    def __sub__(self, other: int | float | ComplexNumber) -> ComplexNumber: ...
    def __mul__(self, other: int | float | ComplexNumber) -> ComplexNumber: ...
    def __pow__(self, power: int) -> ComplexNumber: ...
    def __radd__(self, other: int | float) -> ComplexNumber: ...
    def __rsub__(self, other: int | float) -> ComplexNumber: ...
    def __rmul__(self, other: int | float) -> ComplexNumber: ...
    def __rtruediv__(self, other: int | float) -> ComplexNumber: ...
    def __truediv__(self, other: int | float | ComplexNumber) -> ComplexNumber: ...
    def __neg__(self) -> ComplexNumber: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __int__(self) -> int: ...
    def __abs__(self) -> float: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def arg(self, eps: float = 1e-15) -> float: ...
    def print_complex(self) -> None: ...
    def print_real(self) -> None: ...


class Trigonometry:
    @staticmethod
    def _reduce(x: int | float, eps: float = 1e-15) -> int | float: ...

    @staticmethod
    def sin(x: int | float | DualNumber | ComplexNumber, eps: float = 1e-15) -> int | float | DualNumber | ComplexNumber: ...

    @staticmethod
    def cos(x: int | float | DualNumber | ComplexNumber, eps: float = 1e-15) -> int | float | DualNumber | ComplexNumber: ...

    @staticmethod
    def tan(x: int | float | DualNumber | ComplexNumber) -> int | float | DualNumber | ComplexNumber: ...

    @staticmethod
    def cot(x: int | float | DualNumber | ComplexNumber) -> int | float | DualNumber | ComplexNumber: ...


class InverseTrigonometry:
    @staticmethod
    def arctan(x: int | float, eps: float = 1e-15) -> float: ...

    @staticmethod
    def arctan2(y: int | float, x: int | float, eps: float = 1e-15) -> float: ...

    @staticmethod
    def arcsin(x: int | float, eps: float = 1e-15) -> float: ...

    @staticmethod
    def arccos(x: int | float, eps: float = 1e-15) -> float: ...

    @staticmethod
    def arccot(x: int | float, eps: float = 1e-15) -> float: ...


class Hyperbolic:
    @staticmethod
    def sinh(x: int | float | DualNumber | ComplexNumber) -> int | float | DualNumber | ComplexNumber: ...

    @staticmethod
    def cosh(x: int | float | DualNumber | ComplexNumber) -> int | float | DualNumber | ComplexNumber: ...

    @staticmethod
    def tanh(x: int | float | DualNumber | ComplexNumber) -> int | float | DualNumber | ComplexNumber: ...

    @staticmethod
    def coth(x: int | float | DualNumber | ComplexNumber) -> int | float | DualNumber | ComplexNumber: ...


class Roots:
    @staticmethod
    def root(x: int | float | DualNumber | ComplexNumber, n: int, eps: float = 1e-15) -> int | float | DualNumber | ComplexNumber: ...
    @staticmethod
    def sqrt(x: int | float | DualNumber | ComplexNumber, eps: float = 1e-15) -> int | float | DualNumber | ComplexNumber: ...
    @staticmethod
    def sqrt_old(x: int | float | DualNumber, eps: float = 1e-15) -> int | float | DualNumber: ...


class Factorial:
    @staticmethod
    def fact(x: int) -> int: ...


class Functs:
    @staticmethod
    def Pi(eps: float = 1e-15) -> float: ...

    @staticmethod
    def exp(x: int | float | DualNumber | ComplexNumber, eps: float = 1e-15) -> int | float | DualNumber | ComplexNumber: ...

    @staticmethod
    def E(eps: float = 1e-15) -> float: ...

    @staticmethod
    def Phi() -> float: ...

    @staticmethod
    def Fibonacci(x: int) -> int: ...

    @staticmethod
    def Sign(x: int | float) -> int: ...


class Derivate:
    @staticmethod
    def derv(f, x: int | float) -> float: ...


class Log:
    @staticmethod
    def ln(x: int | float | DualNumber | ComplexNumber, eps: float = 1e-15) -> int | float | DualNumber | ComplexNumber: ...

    @staticmethod
    def log(taban: int | float, x: int | float, eps: float = 1e-15, k: int = 0) -> ComplexNumber: ...
